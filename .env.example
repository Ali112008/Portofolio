# Environment Variables
# Copy this file to .env.local and fill in your values

# ── Site ──
# Public canonical URL (used for metadata, sitemap, robots, OG images)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Contact form ──
# Email that receives contact-form submissions
CONTACT_EMAIL="ali.mahmoud.developer@gmail.com"
#
# Real email delivery — set ONE of the following. If neither is set, the
# form falls back to opening the visitor's email client (mailto:).
#
# Option A: Resend (https://resend.com) — needs domain verification to email
# arbitrary addresses (the test sender only works for the account owner).
RESEND_API_KEY=""
# Verified "from" address for Resend, e.g. "Portfolio <noreply@yourdomain.com>"
RESEND_FROM=""
#
# Option B: Web3Forms (https://web3forms.com) — free, no domain verification.
# Sign up with CONTACT_EMAIL, copy the access key they email you.
WEB3FORMS_ACCESS_KEY=""

# ── Database (starter template, not required for the portfolio page) ──
DATABASE_URL="file:./dev.db"

# ── NextAuth (starter template) ──
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# ── GitHub (starter template, for portfolio data) ──
GITHUB_TOKEN=""
GITHUB_USERNAME=""
