# Environment Variables
# Copy this file to .env.local and fill in your values

# ── Site ──
# Public canonical URL (used for metadata, sitemap, robots, OG images)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Contact form ──
# Email that receives contact-form submissions.
CONTACT_EMAIL="ali.mahmoud.developer@gmail.com"
#
# EMAIL DELIVERY — no key required by default!
# The form uses FormSubmit (formsubmit.co), which emails CONTACT_EMAIL with
# no account/key/card. One-time setup: submit the form once on the live site,
# then open CONTACT_EMAIL and click the activation link FormSubmit sends.
# That's it — every later message arrives automatically.
#
# Optional alternatives (only if you want them):
#   Web3Forms  (https://web3forms.com) — free 250/mo, add the key below:
WEB3FORMS_ACCESS_KEY=""
#   Resend      (https://resend.com) — free 3000/mo, needs domain verification:
RESEND_API_KEY=""
RESEND_FROM=""

# ── Database (starter template, not required for the portfolio page) ──
DATABASE_URL="file:./dev.db"

# ── NextAuth (starter template) ──
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# ── GitHub (starter template, for portfolio data) ──
GITHUB_TOKEN=""
GITHUB_USERNAME=""
