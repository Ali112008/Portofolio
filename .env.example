# Environment Variables
# Copy this file to .env.local and fill in your values

# ── Site ──
# Public canonical URL (used for metadata, sitemap, robots, OG images)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Contact form ──
# Email that receives contact-form submissions.
CONTACT_EMAIL="ali.mahmoud.developer@gmail.com"
#
# EMAIL DELIVERY — already wired up via Web3Forms (a public access key is
# baked into src/app/api/contact/route.ts). Works with no extra setup;
# submissions arrive at CONTACT_EMAIL (free 250/mo).
#
# Optional overrides:
#   WEB3FORMS_ACCESS_KEY  — replace the baked-in key with a new form's key.
WEB3FORMS_ACCESS_KEY=""
#   FormSubmit (keyless) is the automatic backup; Resend is also supported:
RESEND_API_KEY=""
RESEND_FROM=""

# ── Database (starter template, not required for the portfolio page) ──
DATABASE_URL="file:./dev.db"

# ── NextAuth (starter template) ──
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# ── GitHub (starter template, for portfolio data) ──
GITHUB_TOKEN=""
GITHUB_USERNAME=""
